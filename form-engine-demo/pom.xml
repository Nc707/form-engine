<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nc</groupId>
        <artifactId>form-engine</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>form-engine-demo</artifactId>
    <name>Form Engine Demo (Vaadin)</name>
    <description>Vaadin UI for Form Engine: form builder, renderer and submission viewer</description>

    <dependencies>
        <!-- Internal dependencies - Business layer (interfaces + implementations).
             The implementations are required at runtime: the interface modules alone
             provide no beans to inject into the views. -->
        <dependency>
            <groupId>com.nc</groupId>
            <artifactId>form-engine-definition-business</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nc</groupId>
            <artifactId>form-engine-definition-businessimpl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nc</groupId>
            <artifactId>form-engine-submission-business</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nc</groupId>
            <artifactId>form-engine-submission-businessimpl</artifactId>
        </dependency>

        <!-- Internal dependencies - Data implementations (entities + repositories) -->
        <dependency>
            <groupId>com.nc</groupId>
            <artifactId>form-engine-definition-dataimpl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nc</groupId>
            <artifactId>form-engine-submission-dataimpl</artifactId>
        </dependency>

        <!-- Vaadin -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing. The views themselves are not tested; what is, is the logic they sit on:
             resolving a submission's answers against the definition it was filled in against,
             reading the stored encoding back out, and writing CSV. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>spring-boot:run</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-frontend</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Production build: compiles the frontend bundle. Kept out of the default
             build so `mvn install` does not require a Node toolchain download. -->
        <profile>
            <id>production</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.vaadin</groupId>
                        <artifactId>vaadin-maven-plugin</artifactId>
                        <version>${vaadin.version}</version>
                        <executions>
                            <execution>
                                <id>frontend</id>
                                <goals>
                                    <goal>prepare-frontend</goal>
                                    <goal>build-frontend</goal>
                                </goals>
                                <phase>compile</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
