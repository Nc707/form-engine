<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.nc</groupId>
    <artifactId>form-engine</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>form-engine-definition-businessimpl</artifactId>
  <dependencies>
  	<dependency>
  		<groupId>com.nc</groupId>
  		<artifactId>form-engine-definition-data</artifactId>
  	</dependency>
  	<!-- Runtime, not compile: every service here goes through form-engine-definition-data's DAO
  	     interfaces, so nothing in src/main is compiled against this jar's entities or
  	     repositories — Spring Boot auto-configuration wires the DAO implementations in from
  	     here at startup. At compile scope this was the dependency that actually leaked the
  	     engine's JPA model onto a form-engine-flow consumer's compile classpath: flow depends
  	     on this module too, and Maven resolves a scope conflict between two paths to a jar by
  	     taking the wider one, so flow's own runtime scope for this jar counted for nothing
  	     while this declaration stayed at compile. -->
  	<dependency>
  		<groupId>com.nc</groupId>
  		<artifactId>form-engine-definition-dataimpl</artifactId>
  		<scope>runtime</scope>
  	</dependency>
		<dependency>
		<groupId>com.nc</groupId>
		<artifactId>form-engine-definition-business</artifactId>
		</dependency>
		<dependency>
		<groupId>com.nc</groupId>
		<artifactId>form-engine-definition-model</artifactId>
		</dependency>
		<dependency>
		<groupId>org.springframework</groupId>
		<artifactId>spring-tx</artifactId>
		</dependency>
		<!-- Auto-configuration: this module registers its own service beans. -->
		<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>
		<!-- JUnit 5 + AssertJ for the dependency evaluator tests, which need no container. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

  </dependencies>
</project>